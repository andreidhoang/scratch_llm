*.pt
*.gguf
checkpoints/

# Staged corpora + tokenized sweep data (~23 GB) — manifests/result JSONs stay tracked
artifacts/f12_corpus_ablation/climbmix/
artifacts/f12_corpus_ablation/fineweb_edu/
artifacts/f12_corpus_ablation/parquet/
artifacts/s3_scaling_sweep/data/

# Run outputs — manifests are committed, large logs/traces are not
runs/**/rollouts/
runs/**/*.log
wandb/
*.nsys-rep
*.ncu-rep

# Secrets
.env
*.key

# Course reference PDFs — read-only material, not source
*.pdf

# Local machine state — not source
.venv-backups/
.claude/settings.local.json



# AOT kernel build artifacts (the CMake/setup.py output for csrc/*.cu).
# The extension lands next to src/scratch_llm so `from scratch_llm import
# _scratch_llm_kernels` resolves; it is always rebuilt, never committed.
_scratch_llm_kernels*.so
_scratch_llm_kernels*.pyd
_scratch_llm_kernels*.dylib
csrc/build/
csrc/*.egg-info/
build/
*.egg-info/

# Session tooling
.zcode/

# K3 anatomy — raw checkpoint data is regenerable via scripts/k3_fetch_tensors.py;
# commit only the derived stats (repo rule: never commit weights/datasets)
artifacts/k3_anatomy/index.json
artifacts/k3_anatomy/census.json
artifacts/k3_anatomy/tensors/
artifacts/k3_anatomy/fetch.log
