runs/**/rollouts/
runs/**/*.log
wandb/
*.nsys-rep
*.ncu-rep

# Secrets
.env
*.key

# Course reference PDFs — read-only material, not source
docs/*.pdf

# Local machine state — not source
.venv-backups/
.claude/settings.local.json
